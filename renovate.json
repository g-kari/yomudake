{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "matchDatasources": [
        "npm"
      ],
      "minimumReleaseAge": "1 day"
    }
  ],
  "automerge": true,
  "minimumReleaseAge": "1 day"
}
