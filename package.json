{
  "name": "yomudake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "types": "wrangler types --config wrangler.example.jsonc",
    "dev": "wrangler dev --config wrangler.local.jsonc --local",
    "deploy": "node scripts/require-config.mjs && pnpm run build && wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test:browser": "node tests/browser/notebook.mjs && node tests/browser/list-recovery.mjs && node tests/browser/article-outline.mjs && node tests/browser/article-pagination.mjs"
  },
  "dependencies": {
    "jose": "6.2.12",
    "parse5": "8.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "happy-dom": "20.9.0",
    "miniflare": "5.20261006.1-alpha",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "wrangler": "4.149.0"
  },
  "packageManager": "pnpm@11.25.0"
}
